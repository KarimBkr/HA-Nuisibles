# Public URL of the site (canonical links, sitemap)
NEXT_PUBLIC_SITE_URL=https://www.ha-nuisibles.fr
# Web3Forms access key for the quote form
NEXT_PUBLIC_WEB3FORMS_KEY=
# Cookie-free statistics (Plausible): site domain as declared in Plausible; empty = no script loaded
NEXT_PUBLIC_ANALYTICS_DOMAIN=
# Optional: script URL of a self-hosted Plausible-compatible instance (default https://plausible.io/js/script.js)
NEXT_PUBLIC_ANALYTICS_SRC=
# Google Search Console HTML-tag verification code (content of the meta tag); empty = no tag
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Google "leave a review" link of the Business Profile; empty = no "Laisser un avis" button
NEXT_PUBLIC_GOOGLE_REVIEW_URL=https://g.page/r/CRjoESu5nUf_EBM/review
